# Копия этого файла как .env: docker compose читает его автоматически.
# Каталог с SSH-ключом для доступа к хосту с OpenCode (лучше отдельный каталог только с этим ключом)
HH_SSH_DIR=/path/to/dir/with/key
# Имя файла ключа в этом каталоге
HH_SSH_KEY=id_ed25519
# Часовой пояс, в котором считается окно review.work_hours
TZ=UTC
# На Linux: uid и gid владельца каталога ./config (узнать: id -u, id -g)
# APP_UID=1000
# APP_GID=1000